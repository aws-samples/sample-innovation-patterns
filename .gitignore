.pytest_cache
.DS_Store

.vscode/*
!.vscode/README.md
!.vscode/settings.example.json
!.vscode/extensions.json
.context/

# Node modules — actual deps live in app-specific lockfiles
# (docs/pnpm-lock.yaml, web-client/package-lock.json). A stray root-level
# `npm install` created a package-less node_modules/ that polluted the SAST
# SBOM scan (hono/undici/vite High findings); ignore it so it cannot reappear.
/node_modules/

# Documentation site
docs/build/
docs/.docusaurus/
docs/docs/working/
docs/node_modules/

.env
.venv/
specs/

.temp/
.sav/
.delete/
.data/
.output/
.draft/
.archive/

*.zip

# IPA generated templates (security-sensitive, not committed)
infra/cfn/generated/

.secrets.baseline

# ASH scan output (regenerated on each scan)
.ash/ash_output/

# SpecKit
.claude/commands/speckit.*
.specify/

# OpenSpec
openspec/
.claude/commands/opsx/
.claude/skills/openspec-*/

innovation-patterns*.tar.gz

# Terraform — stray local state from runs invoked outside infra/tf/
# (the proper per-module .gitignore lives at infra/tf/.gitignore)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
.terraform.tfstate.lock.info

.acq/
graphify-out/

